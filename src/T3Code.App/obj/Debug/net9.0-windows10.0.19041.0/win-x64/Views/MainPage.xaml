<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="T3Code.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:T3Code.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:ConnectionId='4'
                x:Name="ConnectionStatusText"
                Text="Connecting..."
                FontSize="13"
                VerticalAlignment="Center" />
            <TextBlock x:ConnectionId='5'
                x:Name="BackendPidText"
                Grid.Column="1"
                Text=""
                FontSize="12"
                Foreground="Gray"
                VerticalAlignment="Center" />
        </Grid>

        <TextBlock
            Grid.Row="1"
            Text="Projects"
            FontSize="18"
            FontWeight="SemiBold"
            Margin="0,0,0,8" />

        <ListView x:ConnectionId='2' Grid.Row="2" x:Name="ProjectsList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Cwd}" FontSize="11" Foreground="Gray" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

