<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="T3Code.App.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Project:" VerticalAlignment="Center" FontSize="13" />
            <ComboBox x:Name="ProjectSelector" Grid.Column="1" MinWidth="200"
                      PlaceholderText="Select a project..." SelectionChanged="OnProjectSelected" />
            <Button x:Name="NewSessionBtn" Grid.Column="2" Content="New Terminal"
                    Style="{StaticResource PrimaryAction}" Click="OnNewSession" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SessionSelector" MinWidth="200" PlaceholderText="Select a session..."
                      SelectionChanged="OnSessionSelected" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CloseSessionBtn" Content="Close" Click="OnCloseSession" />
                <Button x:Name="RestartSessionBtn" Content="Restart" Click="OnRestartSession" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock x:Name="TerminalOutput"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Padding="12"
                       IsTextSelectionEnabled="True"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Stretch" />
        </Grid>

        <Grid Grid.Row="3">
            <TextBox x:Name="TerminalInput"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="13"
                     PlaceholderText="Type a command and press Enter..."
                     KeyDown="OnTerminalInputKeyDown"
                     Margin="0,8,0,0" />
        </Grid>
    </Grid>
</Page>
