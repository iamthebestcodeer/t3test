<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="T3Code.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Auto"
        IsSettingsVisible="True"
        Header="T3 Code"
        PaneDisplayMode="Auto">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Chats" Tag="chats" Icon="Comment" />
            <NavigationViewItem Content="Terminal" Tag="terminal" Icon="CommandPrompt" />
            <NavigationViewItem Content="Diff" Tag="diff" Icon="Compare" />
            <NavigationViewItem Content="Git" Tag="git" Icon="Branch" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
