<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="T3Code.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Theme:" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeSelector" Grid.Column="1" MinWidth="200"
                          SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="System" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="Runtime" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default Mode:" VerticalAlignment="Center" />
                <ComboBox x:Name="DefaultModeSelector" Grid.Column="1" MinWidth="200"
                          SelectionChanged="OnDefaultModeChanged">
                    <ComboBoxItem Content="Web" Tag="Web" />
                    <ComboBoxItem Content="Desktop" Tag="Desktop" />
                    <ComboBoxItem Content="Terminal" Tag="Terminal" />
                </ComboBox>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Interaction:" VerticalAlignment="Center" />
                <ComboBox x:Name="InteractionSelector" Grid.Column="1" MinWidth="200"
                          SelectionChanged="OnInteractionChanged">
                    <ComboBoxItem Content="Default" Tag="Default" />
                    <ComboBoxItem Content="Plan" Tag="Plan" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Status:" VerticalAlignment="Center" />
                <TextBlock x:Name="UpdateStatusText" Grid.Column="1"
                           Text="Disabled" VerticalAlignment="Center" Foreground="Gray" />
                <Button x:Name="CheckUpdatesBtn" Grid.Column="2" Content="Check for Updates"
                        Click="OnCheckUpdates" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="8" Margin="0,24,0,0">
            <TextBlock Text="Backend" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PID:" VerticalAlignment="Center" />
                <TextBlock x:Name="BackendPidText" Grid.Column="1"
                           Text="N/A" VerticalAlignment="Center" Foreground="Gray" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RestartBackendBtn" Content="Restart Backend"
                        Click="OnRestartBackend" />
                <Button x:Name="ViewLogsBtn" Content="View Logs"
                        Click="OnViewLogs" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
