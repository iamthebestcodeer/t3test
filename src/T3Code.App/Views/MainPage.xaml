<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="T3Code.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:T3Code.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="StatusIcon" Glyph="&#xE894;" FontSize="14" VerticalAlignment="Center" />
            <TextBlock x:Name="ConnectionStatusText" Grid.Column="1"
                       Text="Connecting..." FontSize="13" VerticalAlignment="Center" />
            <TextBlock x:Name="BackendPidText" Grid.Column="2"
                       Text="" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
            <Button x:Name="NewThreadBtn" Grid.Column="3" Content="New Thread"
                    Style="{StaticResource PrimaryAction}" Click="OnNewThread"
                    IsEnabled="False" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Projects" FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ListView Grid.Row="1" x:Name="ThreadList" SelectionChanged="OnThreadSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="Gray"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8BD;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock x:Name="ThreadTitleText" Grid.Column="1"
                               Text="Select a thread" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="InterruptBtn" Content="Stop" Click="OnInterrupt"
                                IsEnabled="False" Visibility="Visible" />
                        <Button x:Name="DiffBtn" Content="View Diff" Click="OnViewDiff"
                                IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <ListView Grid.Row="1" x:Name="MessageList"
                          Padding="12,4"
                          SelectionMode="None"
                          IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,6" Margin="0,0,0,8" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Row="0" Grid.RowSpan="2" Glyph="{Binding RoleGlyph}"
                                          FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding RoleLabel}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Timestamp}" FontSize="11"
                                               Foreground="Gray" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Text}" FontSize="13"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Margin="0,4,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="2" Padding="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptInput" Grid.Column="0"
                             PlaceholderText="Type a message..."
                             FontSize="14"
                             KeyDown="OnPromptKeyDown" />
                    <Button x:Name="SendBtn" Grid.Column="1" Content="Send"
                            Style="{StaticResource PrimaryAction}"
                            Click="OnSendPrompt"
                            IsEnabled="False"
                            Margin="8,0,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
